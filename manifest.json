{
  "options_page": "src/options.html",
  "action": {
    "default_icon": "img/favicon.png",
    "default_title": "URL and Title Copier",
    "default_popup": "src/popup.html"
  },
  "description": "URLとタイトルをWebページから取得します",
  "icons": {
    "48": "img/icon_1000.png"
  },
  "name": "URL and Title Copier",
  "permissions": [
    "tabs",
    "contextMenus",
    "clipboardWrite",
    "scripting",
	"storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "version": "0.4.2",
  "manifest_version": 3
}
